{
  "name": "nxjt",
  "version": "0.0.1",
  "private": true,
  "description": "Quickly navigate to npmx common webpages.",
  "keywords": [
    "npmx",
    "nxjt",
    "npmxpmx-jump-tp",
    "chrome",
    "firefox",
    "alfred"
  ],
  "homepage": "https://nxjt.netlify.app/",
  "bugs": {
    "url": "https://github.com/trueberryless-org/nxjt/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trueberryless-org/nxjt.git"
  },
  "license": "MIT",
  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "dev": "astro dev",
    "lint": "prettier -c --cache . && eslint . --cache --max-warnings=0 && tsc --noEmit && astro check",
    "prepare": "husky",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "vitest"
  },
  "lint-staged": {
    "*": [
      "prettier -w -u --cache",
      "eslint --cache --no-warn-ignored --max-warnings=0"
    ]
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/netlify": "^8.2.5",
    "@astrojs/vercel": "11.0.10",
    "@unocss/reset": "66.10.0",
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@hideoo/eslint-config": "4.1.1",
    "@hideoo/prettier-config": "2.0.0",
    "@hideoo/tsconfig": "2.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "husky": "9.0.11",
    "lint-staged": "17.5.0",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "7.0.2",
    "vercel": "59.11.7",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=18"
  }
}
